From: tj-barrett <barrett.t@northeastern.edu>
Subject: [PATCH] pardiso.c: set PARDISO parameters explicitly and check its result

ccx called PARDISO with iparm[0]=0 (all defaults) and ignored its error code. For
the symmetric indefinite systems of periodic RVEs (*EQUATION constraints) this
perturbs small pivots (1e-8) without scaling or matching, and refines only twice.
On a 1.49M-equation fiber RVE, PARDISO perturbed 27 pivots and returned a solution
with 8e-4 relative error and no warning; reciprocal reaction forces that must be
equal came out as -104.3 and 7.85.

Set the parameters explicitly: scaling and weighted matching (iparm[10], iparm[12]),
up to 10 iterative refinement steps on every solve (iparm[7]), unchanged pivot
perturbation (1e-8 symmetric, 1e-13 unsymmetric) and Bunch-Kaufman pivoting.
Report the number of perturbed pivots and the refinement steps used, and stop with
a message when PARDISO returns an error.

Error -4 in the solve phase means that iterative refinement did not reach PARDISO's
own tolerance, which happens for tiny right-hand sides such as Newton corrections.
In that case compute the normwise backward error |b-Ax|/(|A||x|+|b|) of the
returned solution from the CSR arrays and accept it below 1e-10 (observed values:
1e-16), otherwise stop.

On the 1.49M-equation model the result now agrees with PaStiX to 7e-13 at the
same run time (773 s).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/ccx_2.23/src/pardiso.c
+++ b/ccx_2.23/src/pardiso.c
@@ -30,6 +30,63 @@
 ITG *icolpardiso=NULL,*pointers=NULL,iparm[64];
 long long pt[64];
 double *aupardiso=NULL;
+
+/* PARDISO parameters. ccx used to pass iparm[0]=0 (all defaults): for the symmetric
+   indefinite systems of periodic RVEs that perturbs small pivots without scaling or
+   matching, and the result was not checked; at ~1.5M equations it returned a solution
+   with 8e-4 relative error and no warning. Set the parameters explicitly instead:
+   scaling + weighted matching, iterative refinement on every solve, and report
+   perturbed pivots and errors. Indices are 0-based (C) as in the MKL manual. */
+static void pardiso_set_iparm(ITG mtype){
+  ITG i;
+  for(i=0;i<64;i++){iparm[i]=0;}
+  iparm[0]=1;                        /* parameters supplied */
+  iparm[1]=3;                        /* parallel nested dissection ordering */
+  iparm[7]=10;                       /* max. iterative refinement steps */
+  iparm[9]=(mtype==-2) ? 8 : 13;     /* pivot perturbation 1e-8 / 1e-13 */
+  iparm[10]=1;                       /* scaling */
+  iparm[12]=1;                       /* weighted matching */
+  iparm[20]=1;                       /* Bunch-Kaufman pivoting (symmetric indefinite) */
+}
+
+/* normwise backward error |b-Ax|_inf / (|A|_inf |x|_inf + |b|_inf) of a solution,
+   from the CSR arrays handed to PARDISO (1-based; upper triangle for mtype=-2) */
+static double pardiso_backward_error(ITG mtype, ITG n, const double *x,
+                                     const double *b){
+  ITG i,j,k;
+  double *r=NULL,*rowsum=NULL,a,rmax=0.,amax=0.,xmax=0.,bmax=0.;
+  NNEW(r,double,n);
+  NNEW(rowsum,double,n);
+  for(i=0;i<n;i++){r[i]=b[i];}
+  for(i=0;i<n;i++){
+    for(k=pointers[i]-1;k<pointers[i+1]-1;k++){
+      j=icolpardiso[k]-1;
+      a=aupardiso[k];
+      r[i]-=a*x[j];
+      rowsum[i]+=fabs(a);
+      if(mtype==-2 && j!=i){
+        r[j]-=a*x[i];
+        rowsum[j]+=fabs(a);
+      }
+    }
+  }
+  for(i=0;i<n;i++){
+    if(fabs(r[i])>rmax) rmax=fabs(r[i]);
+    if(rowsum[i]>amax) amax=rowsum[i];
+    if(fabs(x[i])>xmax) xmax=fabs(x[i]);
+    if(fabs(b[i])>bmax) bmax=fabs(b[i]);
+  }
+  SFREE(r);
+  SFREE(rowsum);
+  return (amax*xmax+bmax>0.) ? rmax/(amax*xmax+bmax) : 0.;
+}
+
+static void pardiso_check(const char *what, ITG error){
+  if(error!=0){
+    printf(" *ERROR in pardiso (%s): error code %" ITGFORMAT "\n",what,error);
+    FORTRAN(stop,());
+  }
+}
 /* double dparm[64];  not used */
 ITG mthread_mkl=0;
 char envMKL[32];
@@ -53,8 +110,6 @@
     printf(" Factoring the system of equations using the unsymmetric pardiso solver\n");
   }
 
-  iparm[0]=0;
-  iparm[1]=3;
   /* set MKL_NUM_THREADS to min(CCX_NPROC_EQUATION_SOLVER,OMP_NUM_THREADS)
      must be done once  */
   if (mthread_mkl == 0) {
@@ -300,10 +355,15 @@
 /* next line is for the simulateous use of PARDISO and PaStiX */
 
   mkl_domain_set_num_threads(mthread_mkl,MKL_DOMAIN_PARDISO);
-  
+
+  pardiso_set_iparm(mtype);
   FORTRAN(pardiso,(pt,&maxfct,&mnum,&mtype,&phase,neq,aupardiso,
 		   pointers,icolpardiso,perm,&nrhs,iparm,&msglvl,
                    b,x,&error));
+  pardiso_check("factorization",error);
+  if(iparm[13]>0){
+    printf(" pardiso: %" ITGFORMAT " perturbed pivots\n",iparm[13]);
+  }
 
   return;
 }
@@ -330,9 +390,7 @@
       mtype=1;
     }
   }
-  iparm[1]=3;
-  
-  /* pardiso_factor has been called before, MKL_NUM_THREADS=mthread_mkl is set*/
+  /* pardiso_factor has been called before; iparm was set there, MKL_NUM_THREADS=mthread_mkl is set*/
 
   //  printf(" number of threads =% d\n\n",mthread_mkl);
 
@@ -341,6 +399,24 @@
   FORTRAN(pardiso,(pt,&maxfct,&mnum,&mtype,&phase,neq,aupardiso,
 		   pointers,icolpardiso,perm,nrhs,iparm,&msglvl,
                    b,x,&error));
+  if(error==-4){
+    /* -4 in the solve phase: iterative refinement did not reach PARDISO's own
+       tolerance (typically for a tiny right-hand side, e.g. a Newton correction).
+       Accept the solution if its backward error is small, otherwise stop. */
+    ITG irhs;
+    double berr,berrmax=0.;
+    for(irhs=0;irhs<*nrhs;irhs++){
+      berr=pardiso_backward_error(mtype,*neq,&x[irhs**neq],&b[irhs**neq]);
+      if(berr>berrmax) berrmax=berr;
+    }
+    printf(" pardiso: iterative refinement did not converge, backward error %e\n",
+           berrmax);
+    if(berrmax<1.e-10) error=0;
+  }
+  pardiso_check("solve",error);
+  if(iparm[13]>0){
+    printf(" pardiso: %" ITGFORMAT " iterative refinement steps\n",iparm[6]);
+  }
 
   for(i=0;i<*nrhs**neq;i++){b[i]=x[i];}
   SFREE(x);
