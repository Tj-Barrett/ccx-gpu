 kernels/gpus/LightSpMV-1.0/src/cLightSpMV.h  |  8 +++++---
 kernels/gpus/LightSpMV-1.0/src/lspmv_idx.h   | 11 +++++++++++
 8 files changed, 39 insertions(+), 20 deletions(-)
 create mode 100644 kernels/gpus/LightSpMV-1.0/src/lspmv_idx.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 24fb9e5..cd2ee9b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -282,6 +282,11 @@ if( PASTIX_WITH_CUDA )
         set(CMAKE_REQUIRED_LIBRARIES "${saved_libs}")
         set(PASTIX_CUDA_ARCH "86" CACHE STRING "GPU compute capability for CUDA kernels (e.g. 86 for RTX 30xx)")
         list(APPEND CUDA_NVCC_FLAGS -O3 -arch=sm_${PASTIX_CUDA_ARCH} -w )
+        # LightSpMV receives pastix_int_t index arrays straight from PaStiX
+        if(NOT PASTIX_INT64)
+            add_definitions(-DLSPMV_IDX32)
+            list(APPEND CUDA_NVCC_FLAGS -DLSPMV_IDX32)
+        endif()
         
 		set(CUDA_SEPARABLE_COMPILATION ON)
 
