+/* Index type of the CSR row-offset / column arrays handed in by PaStiX.
+ * Must match pastix_int_t: LSPMV_IDX32 is defined by CMake when PASTIX_INT64=OFF. */
+#ifndef LSPMV_IDX_H_
+#define LSPMV_IDX_H_
+#include <stdint.h>
+#ifdef LSPMV_IDX32
+typedef int32_t lspmv_idx_t;
+#else
+typedef int64_t lspmv_idx_t;
+#endif
+#endif
