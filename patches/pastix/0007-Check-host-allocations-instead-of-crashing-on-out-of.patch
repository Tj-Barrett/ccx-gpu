+
 /*
  * Function: pastix_protected_malloc
  *
@@ -95,8 +97,11 @@ static inline void *pastix_malloc_func( size_t size,
 #ifdef PASTIX_WITH_CUDA
 #define MALLOC_HOST(ptr, size, type, gpu)                          \
     do {                                                        \
-		if(gpu)													\
-			cudaMallocHost((void**)&ptr, (size) * sizeof(type)) ;          \
+		if(gpu) {												\
+			if( cudaMallocHost((void**)&ptr, (size) * sizeof(type)) != cudaSuccess ) \
+				pastix_alloc_failed( (size_t)((size) * sizeof(type)),  \
+				                     "cudaMallocHost", __FILE__, __LINE__ ); \
+		}														\
 		else            										\
 			ptr = (type*)memAlloc((size) * sizeof(type)) ;          \
     } while(0)
diff --git a/common/pastix_alloc_check.h b/common/pastix_alloc_check.h
new file mode 100644
index 0000000..81af636
--- /dev/null
+++ b/common/pastix_alloc_check.h
@@ -0,0 +1,70 @@
+/**
+ * @file pastix_alloc_check.h
+ *
+ * Checked host allocations.
+ *
+ * SPDX-License-Identifier: CECILL-C
+ *
+ * PaStiX (and the PaRSEC task code generated for it) did not check the result of
+ * malloc/calloc/realloc, so running out of memory -- typically while allocating
+ * the factors of a large matrix -- showed up as a segfault somewhere later. This
+ * header is force-included in every C file of the library (see CMakeLists.txt) and
+ * turns a failed allocation into an error message naming the size and location.
+ *
+ * A NULL result is only an error for a non-zero size: malloc(0) may legally
+ * return NULL. Calls through function pointers named malloc must be written
+ * (s.malloc)(n) to keep them out of the macro.
+ */
+#ifndef _pastix_alloc_check_h_
+#define _pastix_alloc_check_h_
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+static inline void
+pastix_alloc_failed( size_t size, const char *what, const char *file, int line )
+{
+    fprintf( stderr,
+             "\nPaStiX error: %s of %zu bytes (%.2f GB) failed at %s:%d\n"
+             "PaStiX error: not enough memory; the factorization needs more memory than is available\n",
+             what, size, (double)size / 1073741824., file, line );
+    exit( EXIT_FAILURE );
+}
+
+static inline void *
+pastix_checked_malloc( size_t size, const char *file, int line )
+{
+    void *ptr = malloc( size );
+    if ( (ptr == NULL) && (size > 0) ) {
+        pastix_alloc_failed( size, "malloc", file, line );
+    }
+    return ptr;
+}
+
+static inline void *
+pastix_checked_calloc( size_t nmemb, size_t size, const char *file, int line )
+{
+    void *ptr = calloc( nmemb, size );
+    if ( (ptr == NULL) && (nmemb > 0) && (size > 0) ) {
+        pastix_alloc_failed( (size > SIZE_MAX / nmemb) ? SIZE_MAX : nmemb * size,
+                             "calloc", file, line );
+    }
+    return ptr;
+}
+
+static inline void *
+pastix_checked_realloc( void *old, size_t size, const char *file, int line )
+{
+    void *ptr = realloc( old, size );
+    if ( (ptr == NULL) && (size > 0) ) {
+        pastix_alloc_failed( size, "realloc", file, line );
+    }
+    return ptr;
+}
+
+#define malloc( _size_ )           pastix_checked_malloc( (_size_), __FILE__, __LINE__ )
+#define calloc( _nmemb_, _size_ )  pastix_checked_calloc( (_nmemb_), (_size_), __FILE__, __LINE__ )
+#define realloc( _ptr_, _size_ )   pastix_checked_realloc( (_ptr_), (_size_), __FILE__, __LINE__ )
+
+#endif /* _pastix_alloc_check_h_ */
