+# Turn failed host allocations into an error message instead of a later segfault
+# (also covers the PaRSEC task code generated from the .jdf files)
+add_compile_options("SHELL:$<$<COMPILE_LANGUAGE:C>:-include ${CMAKE_CURRENT_SOURCE_DIR}/common/pastix_alloc_check.h>")
+
 include(CMakeDependentOption)
 include(CheckFunctionExists)
 
