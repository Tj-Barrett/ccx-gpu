 kernels/gpus/LightSpMV-1.0/src/SpMVCSR.h | 69 ++++++++++++++++--------
 1 file changed, 47 insertions(+), 22 deletions(-)

diff --git a/kernels/gpus/LightSpMV-1.0/src/SpMVCSR.h b/kernels/gpus/LightSpMV-1.0/src/SpMVCSR.h
index 27a9ca9..bbd245d 100644
