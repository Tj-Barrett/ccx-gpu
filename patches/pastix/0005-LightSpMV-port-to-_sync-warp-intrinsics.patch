@@ -16,6 +16,19 @@ extern __constant__ int64_t _cudaNumCols;
 
 namespace spmv_csr {
 
+/* Volta+ (independent thread scheduling) port: the legacy __shfl* intrinsics are
+ * gone, so every shuffle names the lanes taking part explicitly. */
+#define LSPMV_FULL_MASK 0xffffffffu
+/* lanes of the W-wide vector containing this thread (all lanes of a vector share a row) */
+#define LSPMV_VEC_MASK(W) ((W) >= 32 ? LSPMV_FULL_MASK : \
+	((((1u << (W)) - 1u)) << ((threadIdx.x & 31u) & ~((unsigned)(W) - 1u))))
+/* lanes of a warp-based kernel still inside the row loop: vectors with base row + warpVectorId < nrows */
+__device__ inline unsigned lspmv_live_mask(int64_t row, int64_t warpVectorId, int64_t tpv) {
+	const int64_t lanes = (_cudaNumRows - (row - warpVectorId)) * tpv;
+	return lanes >= 32 ? LSPMV_FULL_MASK : (lanes <= 0 ? 0u : ((1u << lanes) - 1u));
+}
+
+
 /*device functions*/
 template < typename T>
 __device__ inline T shfl_down_64bits(T var, int64_t srcLane,
@@ -24,8 +37,8 @@ __device__ inline T shfl_down_64bits(T var, int64_t srcLane,
 	int2 a = *reinterpret_cast<int2*>(&var);
 
 	/*exchange the data*/
-	a.x = __shfl_down(a.x, srcLane, width);
-	a.y = __shfl_down(a.y, srcLane, width);
+	a.x = __shfl_down_sync(LSPMV_VEC_MASK(width), a.x, srcLane, width);
+	a.y = __shfl_down_sync(LSPMV_VEC_MASK(width), a.y, srcLane, width);
 	
 	return *reinterpret_cast<T*>(&a);
 }
