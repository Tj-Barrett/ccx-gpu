+	row = __shfl_sync(LSPMV_FULL_MASK, row, 0) + warpVectorId;
 
 	/*check the row range*/
 	while (row < _cudaNumRows) {
+		const unsigned liveMask = lspmv_live_mask(row, warpVectorId, THREADS_PER_VECTOR);
 
