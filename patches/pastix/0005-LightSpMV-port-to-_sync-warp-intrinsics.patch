-			sum += __shfl_down(sum, i, THREADS_PER_VECTOR);
+			sum += __shfl_down_sync(LSPMV_VEC_MASK(THREADS_PER_VECTOR), sum, i, THREADS_PER_VECTOR);
 		}
 
