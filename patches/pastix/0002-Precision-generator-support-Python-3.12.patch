From c5649b1fa51bbf9bd0d5fd1945b2c71cc18f86c5 Mon Sep 17 00:00:00 2001
From: tj-barrett <barrett.t@northeastern.edu>
Date: Thu, 15 Oct 2026 21:21:35 -0400
Subject: [PATCH 2/6] Precision generator: support Python 3.12

Drop the unused 'imp' import (removed in 3.12), strip '\s*' from re.sub replacement
strings (an error since 3.7) and send diagnostics to stderr: they were printed to stdout,
which CMake parses as the dependency list, producing a broken Makefile.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../morse_cmake/modules/precision_generator/Conversion.py    | 3 ++-
 .../modules/precision_generator/genDependencies.py           | 5 +++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/cmake_modules/morse_cmake/modules/precision_generator/Conversion.py b/cmake_modules/morse_cmake/modules/precision_generator/Conversion.py
index 5921fe1..f5c8363 100644
--- a/cmake_modules/morse_cmake/modules/precision_generator/Conversion.py
+++ b/cmake_modules/morse_cmake/modules/precision_generator/Conversion.py
@@ -242,12 +242,13 @@ class Conversion:
         replace = work[i][prec_to];
         if not search: continue;
         replace = replace.replace('\*','*');
+        replace = replace.replace('\\s*','');  # py3.7+: \s invalid in re.sub replacement
         if sub_type != 'tracing' :
           replace = replace.replace('\(','(');
           replace = replace.replace('\)',')');
         data = re.sub(search, replace, data);
       except:
-        print('Bad replacement pair ',i,'in',sub_type);
+        print('Bad replacement pair ', i, 'in', sub_type, file=sys.stderr);
         continue;
     return data;
 
diff --git a/cmake_modules/morse_cmake/modules/precision_generator/genDependencies.py b/cmake_modules/morse_cmake/modules/precision_generator/genDependencies.py
index 4e6cccf..c472c83 100755
--- a/cmake_modules/morse_cmake/modules/precision_generator/genDependencies.py
+++ b/cmake_modules/morse_cmake/modules/precision_generator/genDependencies.py
@@ -19,7 +19,7 @@ import re;
 import shlex;
 import os;
 import shutil;
-import imp;
+#import imp;  # removed in Python 3.12, unused
 from os import path;
 from optparse import OptionParser,OptionGroup;
 from datetime import datetime;
@@ -113,12 +113,13 @@ class GenConversion:
         replace = work[i][prec_to];
         if not search: continue;
         replace = replace.replace('\*','*');
+        replace = replace.replace('\\s*','');  # py3.7+: \s invalid in re.sub replacement
         if sub_type != 'tracing' :
           replace = replace.replace('\(','(');
           replace = replace.replace('\)',')');
         data = re.sub(search, replace, data);
       except:
-        print('Bad replacement pair ', i, 'in', sub_type);
+        print('Bad replacement pair ', i, 'in', sub_type, file=sys.stderr);
         continue;
     return data;
 
